# Overrides the Laravel provider's deploy-time commands.
# Everything else (PHP/Node versions, build steps, prepare) is still detected.
load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config", "laravel_serve")

config = laravel_config(
    schema = 1,
    commands = {
        "after_deploy": "php artisan migrate --force",
    },
)

build = laravel_build(config)

laravel_serve(config, build, name = "laravel-wasmer")
